---
interface Props {
  src: string;
  poster?: string;
  title?: string;
  caption?: string;
  captionEn?: string;
}

const { src, poster, title = "文章视频", caption, captionEn } = Astro.props;
---

<figure class="blog-video">
  <video controls playsinline preload="metadata" poster={poster} aria-label={title}>
    <source src={src} type="video/mp4" />
    你的浏览器暂时无法播放这段视频，可以直接打开视频文件查看。
  </video>
  {(caption || captionEn) && (
    <figcaption>
      <span data-lang="zh">{caption ?? captionEn}</span>
      <span data-lang="en">{captionEn ?? caption}</span>
    </figcaption>
  )}
</figure>

<style>
  .blog-video {
    margin: 1.75rem 0;
  }

  .blog-video video {
    display: block;
    width: 100%;
    max-height: 72vh;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: #050505;
    object-fit: contain;
  }

  .blog-video figcaption {
    margin-top: 0.6rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
  }
</style>
