<script>
  const nowScroll = document.querySelector<HTMLElement>("[data-now-scroll]");
  const nowScrollShell = document.querySelector<HTMLElement>("[data-now-scroll-shell]");

  const updateNowScrollCues = () => {
    if (!nowScroll || !nowScrollShell) return;
    const overflow = nowScroll.scrollHeight > nowScroll.clientHeight + 1;
    nowScrollShell.dataset.overflow = overflow.toString();
    nowScrollShell.dataset.atStart = (nowScroll.scrollTop <= 1).toString();
    nowScrollShell.dataset.atEnd = (
      nowScroll.scrollTop + nowScroll.clientHeight >= nowScroll.scrollHeight - 1
    ).toString();
  };

  nowScroll?.addEventListener("scroll", updateNowScrollCues, { passive: true });
  window.addEventListener("resize", updateNowScrollCues);
  if (nowScroll && "ResizeObserver" in window) {
    new ResizeObserver(updateNowScrollCues).observe(nowScroll);
  }
  updateNowScrollCues();

  const nowItemsElements = Array.from(document.querySelectorAll<HTMLElement>("[data-now-item]"));
  const nowActiveEmpty = document.querySelector<HTMLElement>("[data-now-active-empty]");
  const nowArchiveList = document.querySelector<HTMLElement>("[data-now-archive-list]");
  const nowArchiveEmpty = document.querySelector<HTMLElement>("[data-now-archive-empty]");
  const nowArchiveCount = document.querySelector<HTMLElement>("[data-now-archive-count]");
  const archivedRows = new Map<HTMLElement, HTMLElement>();
  const dayInMilliseconds = 86_400_000;

  const toDayNumber = (value: string) => {
    const [year, month, day] = value.split("-").map(Number);
    return Math.floor(Date.UTC(year, month - 1, day) / dayInMilliseconds);
  };

  const localTodayNumber = () => {
    const today = new Date();
    return Math.floor(
      Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()) / dayInMilliseconds,
    );
  };

  const appendLocalizedText = (
    parent: HTMLElement,
    chinese: string,
    english: string,
  ) => {
    const zh = document.createElement("span");
    zh.dataset.lang = "zh";
    zh.textContent = chinese;
    const en = document.createElement("span");
    en.dataset.lang = "en";
    en.textContent = english;
    parent.append(zh, en);
  };

  const getArchiveRow = (item: HTMLElement, finishedAt: string) => {
    const existing = archivedRows.get(item);
    if (existing) return existing;

    const blogUrl = item.dataset.blogUrl;
    const row = document.createElement(blogUrl ? "a" : "div");
    row.className = "now-archive-entry";
    if (row instanceof HTMLAnchorElement && blogUrl) {
      row.href = blogUrl;
      if (/^https?:\/\//.test(blogUrl)) {
        row.target = "_blank";
        row.rel = "noopener noreferrer";
      }
    }

    const title = document.createElement("strong");
    appendLocalizedText(
      title,
      item.dataset.titleZh ?? "",
      item.dataset.titleEn ?? item.dataset.titleZh ?? "",
    );
    const date = document.createElement("span");
    appendLocalizedText(
      date,
      `${finishedAt} 完成${blogUrl ? " · 阅读记录 ↗" : ""}`,
      `Completed ${finishedAt}${blogUrl ? " · Read the post ↗" : ""}`,
    );
    row.append(title, date);
    archivedRows.set(item, row);
    return row;
  };

  const renderNowItems = () => {
    const todayDay = localTodayNumber();
    let activeCount = 0;
    let archiveCount = 0;

    nowItemsElements.forEach((item) => {
      const startedAt = item.dataset.startedAt;
      const deadline = item.dataset.deadline;
      const completedAt = item.dataset.completedAt;
      const deadlineDay = deadline ? toDayNumber(deadline) : null;
      const isArchived = Boolean(completedAt) || (deadlineDay !== null && todayDay >= deadlineDay);
      const previousArchiveRow = archivedRows.get(item);

      if (isArchived) {
        item.hidden = true;
        const finishedAt = completedAt || deadline || "";
        nowArchiveList?.append(getArchiveRow(item, finishedAt));
        archiveCount += 1;
        return;
      }

      previousArchiveRow?.remove();
      item.hidden = false;
      activeCount += 1;

      if (!startedAt || !deadline || deadlineDay === null) return;
      const startedDay = toDayNumber(startedAt);
      const totalDays = Math.max(1, deadlineDay - startedDay);
      const daysUntilStart = Math.max(0, startedDay - todayDay);
      const remainingDays = Math.max(0, deadlineDay - todayDay);
      const elapsedDays = Math.max(0, Math.min(totalDays, todayDay - startedDay));
      const progressRatio = elapsedDays / totalDays;
      const progressPercent = Math.round(progressRatio * 100);
      const progress = item.querySelector<HTMLElement>("[data-now-progress]");
      const status = item.querySelector<HTMLElement>("[data-now-status]");

      progress?.style.setProperty("--progress", progressRatio.toString());
      progress?.setAttribute("aria-valuenow", progressPercent.toString());
      if (status) {
        status.replaceChildren();
        if (daysUntilStart > 0) {
          appendLocalizedText(
            status,
            daysUntilStart === 1 ? "明天开始" : `${daysUntilStart} 天后开始`,
            daysUntilStart === 1 ? "Starts tomorrow" : `Starts in ${daysUntilStart} days`,
          );
        } else {
          appendLocalizedText(
            status,
            `剩余 ${remainingDays} 天`,
            `${remainingDays} day${remainingDays === 1 ? "" : "s"} left`,
          );
        }
      }
    });

    if (nowActiveEmpty) nowActiveEmpty.hidden = activeCount > 0;
    if (nowArchiveEmpty) nowArchiveEmpty.hidden = archiveCount > 0;
    if (nowArchiveCount) nowArchiveCount.textContent = archiveCount.toString();
  };

  const scheduleNextDailyRefresh = () => {
    const now = new Date();
    const nextMidnight = new Date(
      now.getFullYear(),
      now.getMonth(),
      now.getDate() + 1,
      0,
      0,
      1,
    );
    window.setTimeout(() => {
      renderNowItems();
      scheduleNextDailyRefresh();
    }, nextMidnight.getTime() - now.getTime());
  };

  renderNowItems();
  scheduleNextDailyRefresh();
</script>

<script>
  interface StickerElement extends HTMLElement {
    setOptions(options: Record<string, unknown>): void;
    setSource(source: Record<string, unknown>): Promise<void>;
    setRenderScale(scale: number): void;
    getState(): { ready: boolean; dragging: boolean; progress: number };
    reset(): void;
  }

  const heroSticker = document.querySelector<HTMLElement>("[data-hero-sticker]");
  const heroStickerStage = document.querySelector<HTMLElement>("[data-hero-sticker-stage]");

  if (heroSticker && heroStickerStage) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const navigatorWithConnection = navigator as Navigator & {
      connection?: { saveData?: boolean };
    };
    const canUseWebGL = "WebGLRenderingContext" in window;

    if (!reducedMotion && !navigatorWithConnection.connection?.saveData && canUseWebGL) {
      let loading = false;

      const loadSticker = async () => {
        if (loading || heroSticker.classList.contains("is-ready")) return;
        loading = true;

        try {
          await import("../vendor/sticker-forge.es.js");
          await customElements.whenDefined("sticker-forge");

          const sticker = document.createElement("sticker-forge") as StickerElement;
          sticker.style.cssText = "display:block;width:100%;height:100%";
          sticker.setOptions({
            outline: { width: 0, color: "#ffffff" },
            shadow: { opacity: 0.18, blur: 18, distance: 10, angle: 42 },
            peel: {
              radius: 0.15,
              stiffness: 0.78,
              maxAngle: 3.4,
              grabWidth: 28,
              release: "reset",
            },
            sound: { enabled: false, volume: 0 },
            back: { color: "#f5f3ef", gloss: 0.45, roughness: 0.55 },
            tilt: -3,
          });

          heroStickerStage.append(sticker);
          await sticker.setSource({
            type: "image",
            src: "/images/automail-sticker.png",
            name: "automail-sticker.png",
          });
          sticker.setRenderScale(1.25);

          const stickerCanvas = sticker.shadowRoot?.querySelector("canvas");
          if (stickerCanvas) {
            stickerCanvas.tabIndex = -1;
            stickerCanvas.style.outline = "none";
          }

          let releaseResetTimer: number | undefined;
          const clearReleaseReset = () => {
            if (releaseResetTimer === undefined) return;
            window.clearTimeout(releaseResetTimer);
            releaseResetTimer = undefined;
          };
          const scheduleReleaseReset = () => {
            clearReleaseReset();

            const state = sticker.getState();
            if (!state.ready || (!state.dragging && state.progress <= 0.01)) return;

            releaseResetTimer = window.setTimeout(() => {
              releaseResetTimer = undefined;
              const currentState = sticker.getState();

              if (currentState.ready) {
                sticker.reset();
                heroSticker.style.setProperty("--hero-sticker-quote-opacity", "0");
              }
            }, 900);
          };

          sticker.addEventListener("peelstart", clearReleaseReset);
          sticker.addEventListener("peelchange", (event) => {
            const progress = (event as CustomEvent<{ progress?: number }>).detail?.progress ?? 0;
            const quoteOpacity = Math.max(0, Math.min(1, (progress - 0.12) / 0.35));
            heroSticker.style.setProperty("--hero-sticker-quote-opacity", quoteOpacity.toString());
          });
          sticker.addEventListener("peelend", (event) => {
            const willReset = (event as CustomEvent<{ willReset?: boolean }>).detail?.willReset ?? true;
            if (willReset) scheduleReleaseReset();

            window.setTimeout(() => {
              heroSticker.style.setProperty("--hero-sticker-quote-opacity", "0");
            }, 280);
          });
          for (const releaseEvent of ["pointerup", "pointercancel", "touchend", "touchcancel"]) {
            window.addEventListener(releaseEvent, scheduleReleaseReset, { capture: true, passive: true });
          }

          heroSticker.classList.add("is-ready");
        } catch (error) {
          console.warn("Interactive sticker unavailable; keeping the static image.", error);
        }
      };

      const scheduleSticker = () => {
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(() => void loadSticker(), { timeout: 1800 });
        } else {
          window.setTimeout(() => void loadSticker(), 600);
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            scheduleSticker();
          }
        },
        { rootMargin: "160px" },
      );

      observer.observe(heroSticker);
      heroSticker.addEventListener("pointerenter", () => void loadSticker(), { once: true });
      heroSticker.addEventListener("touchstart", () => void loadSticker(), { once: true, passive: true });
    }
  }
</script>

<script>
  const writingTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-writing-tab]"));
  const writingPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-writing-panel]"));
  const writingScrollCue = document.querySelector<HTMLElement>("[data-writing-scroll-cue]");

  const updateWritingScrollCue = (panel: HTMLElement) => {
    if (!writingScrollCue) return;

    const hasOlderWriting = panel.scrollHeight > panel.clientHeight + 1;
    const isAtBottom = panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 2;
    writingScrollCue.hidden = !hasOlderWriting || isAtBottom;
  };

  const activateWritingCategory = (category: string, focusTab = false) => {
    const activeTab = writingTabs.find((tab) => tab.dataset.writingTab === category);
    const activePanel = writingPanels.find((panel) => panel.dataset.writingPanel === category);

    if (!activeTab || !activePanel) return;

    writingTabs.forEach((tab) => {
      const isActive = tab === activeTab;
      tab.classList.toggle("is-active", isActive);
      tab.setAttribute("aria-selected", isActive ? "true" : "false");
      tab.tabIndex = isActive ? 0 : -1;
    });

    writingPanels.forEach((panel) => {
      const isActive = panel === activePanel;
      panel.hidden = !isActive;
      panel.tabIndex = isActive ? 0 : -1;
    });

    activePanel.scrollTop = 0;
    updateWritingScrollCue(activePanel);
    if (focusTab) activeTab.focus();
  };

  writingTabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      if (tab.dataset.writingTab) activateWritingCategory(tab.dataset.writingTab);
    });

    tab.addEventListener("keydown", (event) => {
      let nextIndex = index;

      if (event.key === "ArrowRight") nextIndex = (index + 1) % writingTabs.length;
      else if (event.key === "ArrowLeft") nextIndex = (index - 1 + writingTabs.length) % writingTabs.length;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = writingTabs.length - 1;
      else return;

      event.preventDefault();
      const nextCategory = writingTabs[nextIndex]?.dataset.writingTab;
      if (nextCategory) activateWritingCategory(nextCategory, true);
    });
  });

  writingPanels.forEach((panel) => {
    panel.addEventListener("scroll", () => updateWritingScrollCue(panel), { passive: true });
  });

  const initialWritingPanel = writingPanels.find((panel) => !panel.hidden);
  if (initialWritingPanel) updateWritingScrollCue(initialWritingPanel);

  window.addEventListener("resize", () => {
    const activePanel = writingPanels.find((panel) => !panel.hidden);
    if (activePanel) updateWritingScrollCue(activePanel);
  });
</script>
