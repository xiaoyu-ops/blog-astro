---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LabStatusRow from "../components/LabStatusRow.astro";
import { getCollection } from "astro:content";
import nowItems from "../data/now.json";

const posts = (await getCollection("blog")).filter((post) => import.meta.env.DEV || !post.data.draft);
posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const writingCategories = [
  {
    id: "notes",
    labelZh: "随手写",
    labelEn: "Notes",
    emptyZh: "还没有随手写。",
    emptyEn: "No notes here yet.",
    posts: posts.filter((post) => post.data.category === "notes"),
  },
  {
    id: "technical",
    labelZh: "技术",
    labelEn: "Technical",
    emptyZh: "技术文章正在整理中。",
    emptyEn: "Technical posts are on the way.",
    posts: posts.filter((post) => post.data.category === "technical"),
  },
] as const;

const projects = (await getCollection("projects")).filter((project) => !project.data.draft);
projects.sort((a, b) => {
  const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;

  if (orderA !== orderB) {
    return orderA - orderB;
  }

  return new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime();
});

const projectBeams = [
  ["#60a5fa", "#a78bfa"],
  ["#f97316", "#facc15"],
  ["#34d399", "#60a5fa"],
  ["#f472b6", "#c084fc"],
];
---

<Layout title="Zhuoyang Wu" description="吴卓阳 — 具身智能、AI Agent、数据系统。中山大学本科生。">
  <Header />

  <!-- Hero -->
  <section class="flex flex-col px-4 max-w-3xl mx-auto pt-24 md:pt-28 pb-8 overflow-x-clip">
    <div class="fade-up flex items-center justify-between gap-4 mb-4">
      <div class="flex items-center gap-3">
        <img
          src="/avatar-128.jpg"
          alt="Zhuoyang Wu"
          class="w-14 h-14 rounded-full object-cover ring-1 ring-[hsl(var(--border))]"
          width="56"
          height="56"
        />
        <div>
          <h1 class="text-lg font-medium tracking-tight">
            <span data-lang="zh">吴卓阳</span>
            <span data-lang="en">Zhuoyang Wu</span>
          </h1>
          <p class="text-xs text-[hsl(var(--muted-foreground))] font-mono mt-0.5">
            <span data-lang="zh">Zhuoyang Wu</span>
            <span data-lang="en">SYSU · AI</span>
          </p>
        </div>
      </div>
      <div class="hero-sticker" data-hero-sticker>
        <span class="hero-sticker-quote" data-lang="zh" aria-hidden="true">
          做一点<br />有意义的工作
        </span>
        <span class="hero-sticker-quote" data-lang="en" aria-hidden="true">
          Do work<br />that matters
        </span>
        <img
          class="hero-sticker-fallback"
          src="/images/automail-sticker.png"
          alt="机械义肢主题的 Q 版人物贴纸"
          data-language-alt-zh="机械义肢主题的 Q 版人物贴纸"
          data-language-alt-en="A chibi character with a mechanical prosthetic arm"
          width="768"
          height="768"
          decoding="async"
        />
        <div class="hero-sticker-stage" data-hero-sticker-stage aria-hidden="true"></div>
        <span class="hero-sticker-hint" data-lang="zh" aria-hidden="true">拖动边缘</span>
        <span class="hero-sticker-hint" data-lang="en" aria-hidden="true">drag the edge</span>
      </div>
    </div>
    <div class="hero-lower-grid">
      <div class="hero-profile-copy">
        <p data-lang="zh" class="fade-up fade-delay-1 text-[hsl(var(--muted-foreground))] leading-relaxed text-sm mt-3">
          中山大学网络空间安全学院大三本科生。专注<strong class="text-[hsl(var(--foreground))] font-medium">Ai Agent</strong>，并探索<strong class="text-[hsl(var(--foreground))] font-medium">具身智能</strong>（VLA 模型与世界模型），
          探索机器人如何感知物理世界并自主决策，目前还是玩机械臂阶段。
        </p>
        <p data-lang="en" class="fade-up fade-delay-1 text-[hsl(var(--muted-foreground))] leading-relaxed text-sm mt-3">
          I'm a third-year undergraduate at Sun Yat-sen University's School of Cyber Science and Technology.
          My work centers on <strong class="text-[hsl(var(--foreground))] font-medium">AI agents</strong>, with a growing interest in
          <strong class="text-[hsl(var(--foreground))] font-medium">embodied intelligence</strong>, especially VLA models and world models.
          Right now, that mostly means learning by building and experimenting with robot arms.
        </p>
        <div class="fade-up fade-delay-2 mt-4 flex flex-wrap gap-1.5">
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">Go</span>
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">Python</span>
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">C++</span>
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">PyTorch</span>
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">ROS</span>
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">LangGraph</span>
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">PostgreSQL</span>
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">Redis</span>
          <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground))/30] transition-colors">Docker</span>
        </div>
        <div class="fade-up fade-delay-3 mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono text-[hsl(var(--muted-foreground))]">
          <a href="https://github.com/xiaoyu-ops" class="inline-flex items-center gap-1.5 hover:text-[hsl(var(--foreground))] transition-colors" target="_blank" rel="noopener noreferrer">
            <svg class="h-3.5 w-3.5 shrink-0" data-contact-icon="github" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.28-.36 6.72-1.61 6.72-7.25A5.65 5.65 0 0 0 19.22 3.3 5.27 5.27 0 0 0 19.13.3S17.95-.07 15 1.78a13.38 13.38 0 0 0-7 0C5.05-.07 3.87.3 3.87.3a5.27 5.27 0 0 0-.09 3A5.65 5.65 0 0 0 2.28 7.3c0 5.6 3.44 6.85 6.72 7.25A4.8 4.8 0 0 0 8 18v4" />
              <path d="M8 19c-3 .92-3-1.92-4-2" />
            </svg>
            GitHub
          </a>
          <a href="mailto:wuzhuoyang252@gmail.com" class="inline-flex items-center gap-1.5 hover:text-[hsl(var(--foreground))] transition-colors">
            <svg class="h-3.5 w-3.5 shrink-0" data-contact-icon="email" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            Email
          </a>
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 shrink-0" data-contact-icon="wechat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a4 4 0 0 1-4 4H8l-4 3v-3.5A7 7 0 1 1 8 5h7a6 6 0 0 1 6 10Z" />
              <path d="M8 12h.01M12 12h.01M16 12h.01" />
            </svg>
            <span data-lang="zh">微信: woshiwudachong</span>
            <span data-lang="en">WeChat: woshiwudachong</span>
          </span>
        </div>
      </div>

      <aside id="now" class="now-widget fade-up fade-delay-2" aria-labelledby="now-widget-title">
        <div class="now-widget-header">
          <div>
            <span class="now-widget-kicker">NOW</span>
            <h2 id="now-widget-title">
              <span data-lang="zh">正在进行</span>
              <span data-lang="en">In progress</span>
            </h2>
          </div>
          <span class="now-live-indicator" title="Daily refresh">
            <span aria-hidden="true"></span>
            <span class="sr-only" data-lang="zh">每日更新</span>
            <span class="sr-only" data-lang="en">Updated daily</span>
          </span>
        </div>

        <div class="now-scroll-shell" data-now-scroll-shell>
          <div
            class="now-active-list"
            data-now-active-list
            data-now-scroll
            role="region"
            tabindex="0"
            aria-label="正在进行的事项，可上下滚动"
            data-language-aria-zh="正在进行的事项，可上下滚动"
            data-language-aria-en="Current work, scroll vertically"
          >
            <LabStatusRow />
            {nowItems.map((item, index) => (
              <article
                class="now-item"
                style={`--now-order: ${index}`}
                data-now-item
                data-title-zh={item.titleZh}
                data-title-en={item.titleEn}
                data-started-at={item.startedAt}
                data-deadline={item.deadline ?? ""}
                data-completed-at={item.completedAt ?? ""}
                data-blog-url={item.blogUrl ?? ""}
              >
                <div class="now-item-heading">
                  <h3 title={`${item.titleZh} / ${item.titleEn}`}>
                    <span data-lang="zh">{item.titleZh}</span>
                    <span data-lang="en">{item.titleEn}</span>
                  </h3>
                  <span class="now-status" data-now-status>
                    <span data-lang="zh">{item.deadline ? "计算中" : "待定"}</span>
                    <span data-lang="en">{item.deadline ? "Calculating" : "TBD"}</span>
                  </span>
                </div>
                <div
                  class:list={["now-track", { "is-unscheduled": !item.deadline }]}
                  role="progressbar"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow={item.deadline ? "100" : undefined}
                  data-language-aria-zh={`${item.titleZh}的时间进度`}
                  data-language-aria-en={`Timeline progress for ${item.titleEn}`}
                  aria-label={`${item.titleZh}的时间进度`}
                  data-now-progress
                >
                  <span class="now-track-fill"></span>
                </div>
              </article>
            ))}
            <p class="now-empty" data-now-active-empty hidden>
              <span data-lang="zh">这一阶段已完成。</span>
              <span data-lang="en">This chapter is complete.</span>
            </p>
          </div>
        </div>

        <details class="now-archive" data-now-archive>
          <summary>
            <span>
              <span data-lang="zh">已归档</span>
              <span data-lang="en">Archived</span>
            </span>
            <span class="now-archive-count" data-now-archive-count>0</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="now-archive-list" data-now-archive-list>
            <p class="now-archive-empty" data-now-archive-empty>
              <span data-lang="zh">完成的事情会收进这里。</span>
              <span data-lang="en">Finished work will collect here.</span>
            </p>
          </div>
        </details>
      </aside>
    </div>
    <div class="fade-up fade-delay-4 mt-8 text-center">
      <span class="text-xs text-[hsl(var(--muted-foreground))/40] font-mono animate-pulse">↓ scroll</span>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-6 md:py-8 px-4 max-w-3xl mx-auto">
    <div class="fade-up group mb-4">
      <div class="flex items-center gap-2">
        <div class="decorate-bar h-4"></div>
        <h2 class="text-xs font-mono font-medium text-[hsl(var(--muted-foreground))] transition-colors duration-700 group-hover:text-[hsl(var(--foreground))]">
          <span data-lang="zh">关于</span>
          <span data-lang="en">About</span>
        </h2>
      </div>
    </div>
    <div data-lang="zh" class="fade-up fade-delay-1 space-y-4 text-sm leading-relaxed text-[hsl(var(--muted-foreground))]">
      <p>
        中山大学<strong class="text-[hsl(var(--foreground))] font-medium">网络空间安全学院</strong>大三本科生（2027 届），
        就读于深圳校区，GPA 3.66/5.0。拥有约一年半的科研经验，主要方向为大模型训练数据去重和 AI 基础设施。就在7月1号，我考完了大学期间最后一门考试，结束快乐！我的论文投到ICDE还在审稿，希望一切顺利，审稿人求放过。
      </p>
      <p>
        此前在<strong class="text-[hsl(var(--foreground))] font-medium">深信服科技</strong>实习，负责自进化项目的数据挖掘算法开发。这是一个艰巨的项目！
        目前在探索<strong class="text-[hsl(var(--foreground))] font-medium">具身智能</strong>——VLA 模型与世界模型。
        最新在做我的论文阅读项目，我认为源源不断输入论文是很重要的，就算ai再强，我们也要丰富自己，做最后一环的决策，做一个适合大众并拥抱现在ai的阅读项目！
      </p>
      <p class="italic text-xs pt-4 border-t border-[hsl(var(--border))]">
        "做一点有意义的工作"
      </p>
    </div>
    <div data-lang="en" class="fade-up fade-delay-1 space-y-4 text-sm leading-relaxed text-[hsl(var(--muted-foreground))]">
      <p>
        I'm a third-year student at <strong class="text-[hsl(var(--foreground))] font-medium">Sun Yat-sen University's School of Cyber Science and Technology</strong>,
        based on the Shenzhen campus and graduating in 2027. My GPA is 3.66/5.0, and I've spent the past year and a half working on
        training-data deduplication and AI infrastructure. I wrapped up my final exam of the academic year on July 1, and my ICDE submission
        is still under review. Fingers crossed.
      </p>
      <p>
        Before that, I interned at <strong class="text-[hsl(var(--foreground))] font-medium">Sangfor Technologies</strong>, where I developed
        data-mining algorithms for a self-evolving system. It was a demanding project and a valuable lesson in turning research ideas into systems
        that have to work. I'm now exploring <strong class="text-[hsl(var(--foreground))] font-medium">embodied intelligence</strong> through VLA
        models and world models. I'm also building a paper-reading project around a simple belief: even as AI becomes more capable, people still need
        to keep reading, form their own judgment, and remain the final link in the decision-making chain.
      </p>
      <p class="italic text-xs pt-4 border-t border-[hsl(var(--border))]">
        "Do work that matters."
      </p>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="py-6 md:py-8 px-4 max-w-3xl mx-auto">
    <div class="fade-up group mb-3">
      <div class="flex items-center gap-2">
        <div class="decorate-bar h-4"></div>
        <h2 class="text-xs font-mono font-medium text-[hsl(var(--muted-foreground))] transition-colors duration-700 group-hover:text-[hsl(var(--foreground))]">
          <span data-lang="zh">项目</span>
          <span data-lang="en">Projects</span>
        </h2>
      </div>
    </div>
    <div class="space-y-1">
      {projects.map((project, i) => {
        const [beamFrom, beamTo] = projectBeams[i % projectBeams.length];

        return (
          <a href={`/projects/${project.id}`} class={`fade-up fade-delay-${Math.min(i + 1, 4)} block -mx-4 px-4 py-2.5 rounded-lg border border-transparent hover:bg-[hsl(var(--muted))] hover:border-[hsl(var(--border))] hover:-translate-y-0.5 transition-all duration-300 group border-beam`} style={`--beam-from: ${beamFrom}; --beam-to: ${beamTo};`}>
            <div class="flex items-start justify-between gap-4 relative z-[1]">
              <div class="min-w-0">
                <h3 class="text-sm font-medium group-hover:underline underline-offset-4">
                  <span data-lang="zh">{project.data.title}</span>
                  <span data-lang="en">{project.data.titleEn ?? project.data.title}</span>
                </h3>
                <p class="mt-1 text-xs text-[hsl(var(--muted-foreground))] group-hover:text-[hsl(var(--foreground))] transition-colors duration-300">
                  <span data-lang="zh">{project.data.description}</span>
                  <span data-lang="en">{project.data.descriptionEn ?? project.data.description}</span>
                </p>
                {project.data.tags && project.data.tags.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-1">
                    {project.data.tags.map((tag: string, tagIndex: number) => (
                      <span class="inline-flex items-center rounded-md border border-[hsl(var(--border))] px-2 py-0.5 text-xs font-mono text-[hsl(var(--muted-foreground))]">
                        <span data-lang="zh">{tag}</span>
                        <span data-lang="en">{project.data.tagsEn?.[tagIndex] ?? tag}</span>
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Writing -->
  <section id="posts" class="py-6 md:py-8 px-4 max-w-3xl mx-auto">
    <div class="fade-up group mb-3 flex items-end justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="decorate-bar h-4"></div>
        <h2 class="text-xs font-mono font-medium text-[hsl(var(--muted-foreground))] transition-colors duration-700 group-hover:text-[hsl(var(--foreground))]">
          <span data-lang="zh">写作</span>
          <span data-lang="en">Writing</span>
        </h2>
      </div>
      <div class="writing-tabs flex items-center gap-3 font-mono text-xs" role="tablist" aria-label="写作分类 / Writing categories">
        {writingCategories.map((category) => (
          <button
            id={`writing-tab-${category.id}`}
            class:list={["writing-tab", { "is-active": category.id === "notes" }]}
            type="button"
            role="tab"
            aria-selected={category.id === "notes" ? "true" : "false"}
            aria-controls={`writing-panel-${category.id}`}
            tabindex={category.id === "notes" ? "0" : "-1"}
            data-writing-tab={category.id}
          >
            <span data-lang="zh">{category.labelZh}</span>
            <span data-lang="en">{category.labelEn}</span>
            <span class="writing-tab-count">{category.posts.length}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="writing-window-shell fade-up fade-delay-1 relative">
      {writingCategories.map((category) => (
        <div
          id={`writing-panel-${category.id}`}
          class="writing-window"
          role="tabpanel"
          aria-labelledby={`writing-tab-${category.id}`}
          aria-label={`${category.labelZh} / ${category.labelEn}`}
          tabindex={category.id === "notes" ? "0" : "-1"}
          data-writing-panel={category.id}
          hidden={category.id !== "notes"}
        >
          {category.posts.length > 0 ? (
            category.posts.map((post, i) => {
              const [beamFrom, beamTo] = projectBeams[i % projectBeams.length];

              return (
                <a href={`/blog/${post.id}`} class="writing-entry block -mx-4 px-4 py-2.5 rounded-lg border border-transparent hover:bg-[hsl(var(--muted))] hover:border-[hsl(var(--border))] hover:-translate-y-0.5 transition-all duration-300 group border-beam" style={`--beam-from: ${beamFrom}; --beam-to: ${beamTo};`}>
                  <div class="flex h-full items-center justify-between gap-4 relative z-[1]">
                    <div class="min-w-0">
                      <h3 class="flex min-w-0 items-center gap-2 text-sm font-medium group-hover:underline underline-offset-4">
                        <span class="truncate">
                          <span data-lang="zh">{post.data.title}</span>
                          <span data-lang="en">{post.data.titleEn ?? post.data.title}</span>
                        </span>
                        {post.data.draft && (
                          <span class="rounded border border-[hsl(var(--border))] px-1.5 py-0.5 text-[0.625rem] font-mono font-normal text-[hsl(var(--muted-foreground))] no-underline">
                            Draft
                          </span>
                        )}
                      </h3>
                      <p class="writing-description mt-1 text-xs text-[hsl(var(--muted-foreground))] group-hover:text-[hsl(var(--foreground))] transition-colors duration-300">
                        <span data-lang="zh">{post.data.description}</span>
                        <span data-lang="en">{post.data.descriptionEn ?? post.data.description}</span>
                      </p>
                    </div>
                    <span class="text-xs text-[hsl(var(--muted-foreground))] group-hover:text-[hsl(var(--foreground))] transition-colors duration-300 font-mono shrink-0">{post.data.date}</span>
                  </div>
                </a>
              );
            })
          ) : (
            <p class="writing-empty">
              <span data-lang="zh">{category.emptyZh}</span>
              <span data-lang="en">{category.emptyEn}</span>
            </p>
          )}
        </div>
      ))}
      <div class="writing-scroll-cue" data-writing-scroll-cue hidden aria-hidden="true">
