{
  "name": "zhuoyang-wu",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "post:new": "node scripts/new-post.mjs",
    "post:publish": "node scripts/publish-post.mjs",
    "new:post": "node scripts/new-post.mjs",
    "now:list": "node scripts/now.mjs list",
    "now:add": "node scripts/now.mjs add",
    "now:update": "node scripts/now.mjs update",
    "now:complete": "node scripts/now.mjs complete",
    "now:reopen": "node scripts/now.mjs reopen",
    "test:site": "node --test scripts/*.test.mjs",
    "test:worker": "pnpm --dir status-worker check && pnpm --dir status-worker test",
    "test": "pnpm test:site && pnpm test:worker",
    "build": "astro build && node scripts/validate-build.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.1"
  }
}
