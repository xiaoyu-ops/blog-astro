{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lab2-public-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "routes": [],
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [
      {
        "name": "LAB2_GUARD",
        "class_name": "LabStatusGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LabStatusGuard"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
}
